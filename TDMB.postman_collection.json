    {
      "name": "Search Movies by Keyword",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"status code is 200\", function() {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains results array\", function() {\r",
              "    const jsonData = pm.response.json();\r",
              "});\r",
              "\r",
              "pm.test(\"Each result contains required fields\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    jsonData.results.forEach((movie) => {\r",
              "        pm.expect(movie).to.have.property(\"id\");\r",
              "        pm.expect(movie).to.have.property(\"title\");\r",
              "        pm.expect(movie).to.have.property(\"release_date\");\r",
              "        pm.expect(movie).to.have.property(\"overview\");\r",
              "\r",
              "        pm.expect(movie.id).to.not.be.null;\r",
              "        pm.expect(movie.title).to.not.be.empty;\r",
              "    });\r",
              "});\r",
              "pm.test(\"Movie titles are relevant to search keyword\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    const searchKeyword = \"inception\";\r",
              "    jsonData.results.forEach((movie) => {\r",
              "        pm.expect(movie.title.toLowerCase()).to.include(searchKeyword.toLowerCase());\r",
              "    });\r",
              "});\r",
              "pm.test(\"total_results is greater than 0\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"total_results\");\r",
              "    pm.expect(jsonData.total_results).to.be.above(0);\r",
              "});"
            ],
